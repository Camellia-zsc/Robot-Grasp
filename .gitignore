# colcon / ROS2 构建产物
build/
install/
log/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-physics/
venv*/

# C++ / CMake
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# 模型权重（体积大，单独备份）
*.pt
*.pth
*.onnx
*.engine
*_openvino_model/

# YOLO 训练输出
runs/

# 数据集与录制数据（体积大，单独备份）
datasets/
*.bag
*.db3
*.mcap

# 编辑器与系统文件
.vscode/
.idea/
*.swp
.DS_Store
data/

# 大白相机驱动和依赖（从 GitHub 下载，不进 git；重新下载见 scripts/camera_check.sh --help）
ws/src/camera_drivers/
ws/third_party_include/
# OrbbecSDK 在当前目录写的日志
Log/

# 本机凭据和环境变量（仅在本机配置，不发布）
.env
.env.*
!.env.example
.codex/
auth.json

# 验收证据保留；运行时缓存、进程号和服务日志不发布
local_validation/cache/
local_validation/*.pid
local_validation/*.stdout.log
local_validation/*.stderr.log
local_validation/assistant_sim/
local_validation/assistant_ui/
local_validation/capacity_recovery/

# 仅发布所需 PiPER 模型，排除嵌套仓库元数据和其他模型库文件
local_assets/mujoco_menagerie/*
!local_assets/mujoco_menagerie/agilex_piper/
local_assets/mujoco_menagerie/agilex_piper/_scene_*.xml
